+// SWARM: SWARM Wallet and SWARM Rewards are bundled as component
+// extensions. Their ids are fixed by the "key" field in their manifests
+// and are recorded in swarm/README.md. The folders under
+// chrome/browser/resources are put there by swarm/install_swarm_assets.py
+// and turned into resources by component_extension_resources.grd.
+void ComponentLoader::AddSwarmExtensions() {
+  Add(IDR_SWARM_WALLET_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_wallet")));
+  Add(IDR_SWARM_REWARDS_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_rewards")));
+}
