+// SWARM: SWARM Wallet, SWARM Rewards, SWARM Update and SWARM Start are
+// bundled as component extensions. Their ids are fixed by the "key" field in their
+// manifests and are recorded in swarm/README.md. The folders under
+// chrome/browser/resources are put there by swarm/install_swarm_assets.py
+// and turned into resources by component_extension_resources.grd.
+void ComponentLoader::AddSwarmExtensions() {
+  Add(IDR_SWARM_WALLET_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_wallet")));
+  Add(IDR_SWARM_REWARDS_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_rewards")));
+  Add(IDR_SWARM_UPDATE_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_update")));
+  // SWARM Start: the new-tab page, the SWARM Navigator side panel and
+  // the welcome page that swarm-first-run.patch opens on first start.
+  Add(IDR_SWARM_START_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("swarm_start")));
+}
