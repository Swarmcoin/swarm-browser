 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+  // SWARM: privacy defaults. Chromium has no "switch on by default"
+  // mechanism, so the SWARM defaults are appended at the earliest
+  // callback, before anything reads them, and only when the user has not
+  // set them. Chromium then maps them to prefs itself: see
+  // chrome/browser/prefs/chrome_command_line_pref_store.cc, which maps
+  // --no-pings to prefs::kEnableHyperlinkAuditing=false and
+  // --webrtc-ip-handling-policy to prefs::kWebRTCIPHandlingPolicy.
+  // --disable-search-engine-collection is read directly by the
+  // ungoogled-chromium patch of the same name.
+  // Canvas / client-rects / WebGL noise is deliberately NOT enabled
+  // here: it breaks ordinary sites and stays an opt-in flag.
+  {
+    base::CommandLine* swarm_command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!swarm_command_line->HasSwitch("no-pings")) {
+      swarm_command_line->AppendSwitch("no-pings");
+    }
+    if (!swarm_command_line->HasSwitch("webrtc-ip-handling-policy")) {
+      swarm_command_line->AppendSwitchASCII(
+          "webrtc-ip-handling-policy", "default_public_interface_only");
+    }
+    if (!swarm_command_line->HasSwitch(
+            "disable-search-engine-collection")) {
+      swarm_command_line->AppendSwitch(
+          "disable-search-engine-collection");
+    }
+  }
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
