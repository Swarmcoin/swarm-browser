{
  "manifest_version": 3,
  "name": "SWARM Wallet",
  "short_name": "SWARM Wallet",
  "version": "0.0.1",
  "description": "Shielded SWM wallet. Keys never live in the browser; the extension talks to the SWARM wallet host over native messaging.",
  "key": "",
  "minimum_chrome_version": "153",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "SWARM Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/wallet-16.png",
      "32": "icons/wallet-32.png",
      "48": "icons/wallet-48.png",
      "128": "icons/wallet-128.png"
    }
  },
  "icons": {
    "16": "icons/wallet-16.png",
    "32": "icons/wallet-32.png",
    "48": "icons/wallet-48.png",
    "128": "icons/wallet-128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
