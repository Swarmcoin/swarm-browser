{
  "manifest_version": 3,
  "name": "SWARM Start",
  "short_name": "SWARM Start",
  "version": "0.2.0",
  "description": "The SWARM start page for new tabs, the SWARM Navigator side panel and the welcome page. Asks the SWARM price service (wallet.swarm.green) for the SWM price unless you switch that off, and reads the network status only if you turn on its live network tile.",
  "key": "",
  "minimum_chrome_version": "153",
  "permissions": ["storage", "sidePanel", "search"],
  "host_permissions": [
    "https://lwd-main.swarm.green/status.json",
    "https://swarm.green/data/swarm-map-live.json",
    "https://wallet.swarm.green/api/price/swm"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "SWARM Navigator",
    "default_icon": {
      "16": "icons/start-16.png",
      "32": "icons/start-32.png",
      "48": "icons/start-48.png",
      "128": "icons/start-128.png"
    }
  },
  "side_panel": {
    "default_path": "navigator.html"
  },
  "icons": {
    "16": "icons/start-16.png",
    "32": "icons/start-32.png",
    "48": "icons/start-48.png",
    "128": "icons/start-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://lwd-main.swarm.green https://swarm.green https://wallet.swarm.green; img-src 'self'; font-src 'self'; style-src 'self'"
  },
  "content_scripts": [],
  "web_accessible_resources": []
}
