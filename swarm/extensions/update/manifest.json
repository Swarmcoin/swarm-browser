{
  "manifest_version": 3,
  "name": "SWARM Update",
  "short_name": "SWARM Update",
  "version": "0.1.0",
  "description": "Once a day, reads the signed list of SWARM Browser versions from swarm.green and tells you when a new one is out. It never downloads or installs anything by itself.",
  "key": "",
  "minimum_chrome_version": "153",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["https://swarm.green/*"],
  "action": {
    "default_title": "SWARM Update",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/update-16.png",
      "32": "icons/update-32.png",
      "48": "icons/update-48.png",
      "128": "icons/update-128.png"
    }
  },
  "icons": {
    "16": "icons/update-16.png",
    "32": "icons/update-32.png",
    "48": "icons/update-48.png",
    "128": "icons/update-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://swarm.green; img-src 'self'; font-src 'self'; style-src 'self'"
  },
  "content_scripts": [],
  "web_accessible_resources": []
}
