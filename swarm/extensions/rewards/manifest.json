{
  "manifest_version": 3,
  "name": "SWARM Rewards",
  "short_name": "SWARM Rewards",
  "version": "0.0.1",
  "description": "Opt-in rewards. Nothing about your browsing leaves this device. Rewards are not live yet.",
  "key": "",
  "minimum_chrome_version": "153",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "SWARM Rewards",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/rewards-16.png",
      "32": "icons/rewards-32.png",
      "48": "icons/rewards-48.png",
      "128": "icons/rewards-128.png"
    }
  },
  "icons": {
    "16": "icons/rewards-16.png",
    "32": "icons/rewards-32.png",
    "48": "icons/rewards-48.png",
    "128": "icons/rewards-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
